# Copy this to .env and fill in real values. Never commit the real file —
# .gitignore already excludes server/.env.

# Pick one provider. If both are set, TTS_PROVIDER decides which one runs;
# with TTS_PROVIDER unset, Azure is tried first, then OpenAI.
TTS_PROVIDER=azure

# --- Azure Cognitive Services Speech ---
# Recommended for uk-UA and es-ES: its neural voices are named per exact
# locale (uk-UA-PolinaNeural, es-ES-ElviraNeural), not inferred from text.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- OpenAI text-to-speech ---
# Simpler to set up; infers language/accent from the text rather than taking
# an explicit locale, so it cannot promise a Spain accent the way Azure can.
OPENAI_API_KEY=

PORT=8787
