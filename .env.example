# Copy to .env.local (Vite loads it automatically; git ignores it already).
#
# Left unset, the app speaks with the browser's own system voice only — that
# is the default, and is what every current install does. Setting this
# points it at a deployed backend (see server/README.md) for neural speech,
# which falls back to the system voice automatically on any failure.
VITE_TTS_ENDPOINT=
