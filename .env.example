# Copy to .env.local (Vite loads it automatically; git ignores it already).
#
# Left unset, the app speaks with the browser's own system voice only — that
# is the default, and is what every current install does. Setting this
# points it at a deployed backend (see server/README.md) for neural speech,
# which falls back to the system voice automatically on any failure.
VITE_TTS_ENDPOINT=

# Left unset (or anything but "false"), the local on-device AI feature (the
# Settings toggle for AI drawing ideas, and Draw It's AI upgrade) is built
# in and each parent can opt in per device. Set to "false" to pull the whole
# feature from a build — hides the Settings section entirely — without a
# code change, independent of any individual parent's own toggle.
VITE_AI_FEATURE_ENABLED=
